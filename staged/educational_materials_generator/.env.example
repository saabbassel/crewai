# Environment Configuration
# Copy this to .env and update with your settings

# ====================================
# Ollama Configuration
# ====================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120

# ====================================
# Model Selection by Stage
# ====================================

# Stage 1: Discovery & Benchmarking
DISCOVERY_MODEL=llama2:13b #llama2:13b-chat

# Stage 2: Curriculum Architect
CURRICULUM_MODEL=llama2:13b #llama2:13b-chat

# Stage 3: Content Factory
CONTENT_MODEL=llama2:13b #llama2:13b-chat

# Stage 4: Assessment Lab
ASSESSMENT_MODEL=llama2:13b #llama2:13b-chat

# Stage 5: QA Review
QA_MODEL=llama2:13b #llama2:13b-chat

# ====================================
# Output Configuration
# ====================================
OUTPUT_DIR=./output
ARCHIVE_OUTPUTS=true
LOG_LEVEL=INFO

# ====================================
# HITL Configuration
# ====================================
ENABLE_HITL=true
HITL_AFTER_DISCOVERY=true
HITL_AFTER_CURRICULUM=true
HITL_AFTER_CONTENT=false
APPROVAL_TIMEOUT=300

# ====================================
# Standardization
# ====================================
ENFORCE_STANDARDS=true
VALIDATE_SCHEMA=true
CHECK_ACCESSIBILITY=true
GRADE_LEVEL_TARGET=9

# ====================================
# Performance Tuning
# ====================================
PARALLEL_CONTENT_GENERATION=true
MAX_WORKERS=4
CACHE_RESPONSES=true

# ====================================
# Feature Flags
# ====================================
ENABLE_LEARNING_VARIANTS=true
GENERATE_FAILED_EXAMPLES=true
INCLUDE_QA_STAGE=true
